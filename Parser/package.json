{
  "name": "epic-parser",
  "version": "1.0.0",
  "description": "Parser, validator, and stringifier for .epic and .epicx",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./epic": "./src/epic.js",
    "./epicx": "./src/epicx.js",
    "./document": "./src/document.js",
    "./instruction": "./src/instruction.js",
    "./section": "./src/section.js",
    "./time": "./src/time.js",
    "./stringify": "./src/stringify.js",
    "./validate": "./src/validate.js"
  },
  "bin": {
    "epic-parser": "test-runner.mjs"
  },
  "files": [
    "src",
    "examples",
    "test-runner.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node ./test-runner.mjs ./examples/Elem-en_Ellow_Vo.epicx",
    "serve": "serve . -l 8080"
  },
  "license": "Apache-2.0"
}
